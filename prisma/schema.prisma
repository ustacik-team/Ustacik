generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================
// ENUMS
// =====================

enum Role {
  ADMIN
  CUSTOMER
  CRAFTSMAN
}

enum VerificationLevel {
  REGISTERED
  VERIFIED
  APPROVED
}

enum JobStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  EXPIRED
}

enum NotificationType {
  JOB_REQUEST
  JOB_ACCEPTED
  JOB_COMPLETED
  REVIEW_RECEIVED
  VERIFICATION_APPROVED
}

// =====================
// BETTER AUTH
// =====================

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          Role      @default(CUSTOMER)
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  craftsmanProfile    CraftsmanProfile?
  jobRequests         Job[]                @relation("CustomerJobs")
  reviews             Review[]
  notifications       Notification[]
  verificationRecords VerificationRecord[] @relation("Verifier")
  adminLogs           AdminLog[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// =====================
// LOCATION
// =====================

model Region {
  id        String             @id @default(cuid())
  name      String             @unique
  craftsmen CraftsmanProfile[]

  @@index([name])
  @@map("region")
}

// =====================
// CATEGORIES
// =====================

model Category {
  id          String              @id @default(cuid())
  name        String              @unique
  subServices SubService[]
  craftsmen   CraftsmanCategory[]
  jobs        Job[]

  @@index([name])
  @@map("category")
}

model SubService {
  id         String                @id @default(cuid())
  name       String
  categoryId String
  category   Category              @relation(fields: [categoryId], references: [id])
  craftsmen  CraftsmanSubService[]
  jobs       Job[]

  @@index([categoryId])
  @@map("sub_service")
}

// =====================
// CRAFTSMEN
// =====================

model CraftsmanProfile {
  id                         String             @id @default(cuid())
  userId                     String             @unique
  businessName               String?
  bio                        String?
  regionId                   String
  verificationLevel          VerificationLevel  @default(REGISTERED)
  businessRegistrationNumber String?
  workmanshipGuarantee       Boolean            @default(false)
  priceRangeMin              Decimal?           @db.Decimal(10, 2)
  priceRangeMax              Decimal?           @db.Decimal(10, 2)
  subscriptionStatus         SubscriptionStatus @default(FREE)
  totalJobsCompleted         Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region @relation(fields: [regionId], references: [id], onDelete: Restrict)

  categories  CraftsmanCategory[]
  subServices CraftsmanSubService[]

  photos              WorkPhoto[]
  verificationRecords VerificationRecord[]
  jobs                Job[]                @relation("CraftsmanJobs")

  reviews Review[]
  replies ReviewReply[]

  @@index([regionId])
  @@index([verificationLevel])
  @@index([subscriptionStatus])
  @@map("craftsman_profile")
}

model CraftsmanCategory {
  craftsmanId String
  categoryId  String
  craftsman   CraftsmanProfile @relation(fields: [craftsmanId], references: [id], onDelete: Cascade)
  category    Category         @relation(fields: [categoryId], references: [id])

  @@id([craftsmanId, categoryId])
  @@map("craftsman_category")
}

model CraftsmanSubService {
  craftsmanId  String
  subServiceId String
  craftsman    CraftsmanProfile @relation(fields: [craftsmanId], references: [id], onDelete: Cascade)
  subService   SubService       @relation(fields: [subServiceId], references: [id])

  @@id([craftsmanId, subServiceId])
  @@map("craftsman_sub_service")
}

model WorkPhoto {
  id          String           @id @default(cuid())
  craftsmanId String
  imageUrl    String
  createdAt   DateTime         @default(now())
  craftsman   CraftsmanProfile @relation(fields: [craftsmanId], references: [id], onDelete: Cascade)

  @@index([craftsmanId])
  @@map("work_photo")
}

// =====================
// VERIFICATION
// =====================

model VerificationRecord {
  id                 String            @id @default(cuid())
  craftsmanId        String
  level              VerificationLevel
  phoneVerified      Boolean           @default(false)
  idVerified         Boolean           @default(false)
  referencesVerified Boolean           @default(false)
  workPhotosVerified Boolean           @default(false)

  businessRegistrationVerified Boolean           @default(false)
  guaranteeVerified            Boolean           @default(false)
  notes                        String?
  verifiedBy                   String
  verifiedAt                   DateTime          @default(now())
  craftsman                    CraftsmanProfile  @relation(fields: [craftsmanId], references: [id], onDelete: Cascade)
  verifier                     User              @relation("Verifier", fields: [verifiedBy], references: [id])
  logs                         VerificationLog[]

  @@index([craftsmanId])
  @@index([verifiedBy])
  @@index([level])
  @@map("verification_record")
}

model VerificationLog {
  id                   String             @id @default(cuid())
  verificationRecordId String
  action               String
  notes                String?
  createdAt            DateTime           @default(now())
  verificationRecord   VerificationRecord @relation(fields: [verificationRecordId], references: [id], onDelete: Cascade)

  @@index([verificationRecordId])
  @@map("verification_log")
}

// =====================
// JOBS
// =====================

model Job {
  id           String           @id @default(cuid())
  customerId   String
  craftsmanId  String
  categoryId   String
  subServiceId String?
  title        String
  description  String
  address      String
  status       JobStatus        @default(PENDING)
  createdAt    DateTime         @default(now())
  completedAt  DateTime?
  customer     User             @relation("CustomerJobs", fields: [customerId], references: [id])
  craftsman    CraftsmanProfile @relation("CraftsmanJobs", fields: [craftsmanId], references: [id])
  category     Category         @relation(fields: [categoryId], references: [id])
  subService   SubService?      @relation(fields: [subServiceId], references: [id])
  review       Review?

  @@index([customerId])
  @@index([craftsmanId])
  @@index([categoryId])
  @@index([subServiceId])
  @@index([status])
  @@map("job")
}

// =====================
// REVIEWS
// =====================

model Review {
  id            String           @id @default(cuid())
  jobId         String           @unique
  customerId    String
  craftsmanId   String
  punctuality   Int
  workmanship   Int
  priceHonesty  Int
  communication Int
  comment       String?
  createdAt     DateTime         @default(now())
  job           Job              @relation(fields: [jobId], references: [id])
  customer      User             @relation(fields: [customerId], references: [id])
  craftsman     CraftsmanProfile @relation(fields: [craftsmanId], references: [id])
  photos        ReviewPhoto[]
  reply         ReviewReply?

  @@index([customerId])
  @@index([craftsmanId])
  @@map("review")
}

model ReviewPhoto {
  id       String @id @default(cuid())
  reviewId String
  imageUrl String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_photo")
}

model ReviewReply {
  id          String           @id @default(cuid())
  reviewId    String           @unique
  craftsmanId String
  reply       String
  createdAt   DateTime         @default(now())
  review      Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  craftsman   CraftsmanProfile @relation(fields: [craftsmanId], references: [id])

  @@index([craftsmanId])
  @@map("review_reply")
}

// =====================
// NOTIFICATIONS
// =====================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notification")
}

// =====================
// ADMIN LOGS
// =====================

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@map("admin_log")
}
